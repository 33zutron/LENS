{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Lens Core: Help",
      "type": "ocaml.earlybird",
      "request": "launch",
      "program": "${workspaceFolder}/bin/lens-core.bc",
      "arguments": ["--help"],
      "preLaunchTask": "Build Core Bytecode"
    },
    {
      "name": "OLens: Help",
      "type": "ocaml.earlybird",
      "request": "launch",
      "program": "${workspaceFolder}/bin/olens.bc",
      "arguments": ["--help"],
      "preLaunchTask": "Build Core Bytecode"
    },
    {
      "name": "OLens: LSP",
      "type": "ocaml.earlybird",
      "request": "launch",
      "program": "${workspaceFolder}/bin/olens.bc",
      "arguments": ["lsp", "--experimental"],
      "preLaunchTask": "Build Core Bytecode"
    },
    {
      "name": "Test: LS",
      "type": "ocaml.earlybird",
      "request": "launch",
      "program": "${workspaceFolder}/_build/default/src/tests/test.bc",
      "arguments": ["test", "Language Server"],
      "preLaunchTask": "Build Test Bytecode"
    }
  ]
}
