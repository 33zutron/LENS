(library
 (public_name lens.prefiltering)
 (name prefiltering)
 (libraries
    ast_generic
    parser_regexp
    lens.core
    lens.target
 )
 (preprocess
   (pps
      ppx_deriving.show
      ppx_deriving.eq
      ppx_deriving.ord
      ppx_hash
      ppx_profiling
      ppx_sexp_conv
   )
 )
)

(rule
 (targets Lens_prefilter_j.ml Lens_prefilter_j.mli)
 (deps    Lens_prefilter.atd)
 (action  (run atdgen -j -j-strict-fields %{deps})))

(rule
 (targets Lens_prefilter_t.ml Lens_prefilter_t.mli)
 (deps    Lens_prefilter.atd)
 (action  (run atdgen -t %{deps})))
