; This library contains all the "core" data structures used by lens
; except the Rule (now in ../rule/) and the generic AST (now in ../libs/ast_generic)

(library
 (public_name lens.core)
 (name lens_core)
 (wrapped false)
 (libraries
   base
   collections

   ; standard libraries
   str
   uri
   uuidm
   yaml
   sexplib

   ; in libs/
   commons
   telemetry
   parallelism

   lens_core_rule
   lens_core_target
 )
 (preprocess
   (pps
     ppx_profiling
     ppx_deriving.show
     ppx_deriving.eq
     ppx_deriving.ord
     ppx_hash
     visitors.ppx
     ppx_sexp_conv
     commons.ppx
     ppx_telemetry
   )
 )
)

; this is for Lockfile_xtarget.ml and Pattern_match.ml which used multiple
; times the same field names
