; Library defining mostly SCA_dependency.ml and a few related modules.
;
; Note that many of the modules in this directory are just alias to
; SCA types defined now in lens_output_v1.atd as those types are used
; for RPC calls or passed by pylens to lens-core via -targets or
; are part of the Lens CLI output.
;
; The actual SCA code is split in many dirs and files
;  - lens_interfaces/lens_output_v1.atd (lockfile/manifest/ecosystem/...)
;  - OSS/rule/{SCA_version.ml,SCA_pattern.ml}
;  - src/sca/core/{Dependency_source_xtarget.ml, Subproject.ml, ...}
;  - src/sca/scan/{SCA_targeting.ml, SCA_scan.ml, ...}

(library
 (public_name lens.sca)
 (name lens_core_sca)
 (wrapped false)
 (libraries
   base64
   hex
   ; standard libraries
   ; in libs/
   commons
   ; in src/
   ; We should not depend on any other lens libs
   lens.rule ; for lens_output_v1.atd core types like 'ecosystem'
 )
 (preprocess
   (pps
     ppx_profiling
     ppx_deriving.show
     ppx_deriving.eq
     ppx_deriving.ord
     ppx_deriving_yojson
     ppx_hash
   )
 )
)
