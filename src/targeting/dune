; Various operations having to do with selection of files in Lens.
; What they have in common is:
; - dependency on utilities to manipulate file paths (e.g. globbing);
; - no dependency on full-fledged language parsing or the resulting ASTs.

(library
 (public_name lens.targeting)
 (name lens_targeting)
 (wrapped false)
 (libraries
   base
   collections

   commons

   fpath
   glob
   gitignore
   git_wrapper
   lens.target
   lens.core
 )
 (preprocessor_deps (file default.lensignore))
 (preprocess
   (pps
     ppx_blob
     ppx_profiling
     telemetry.ppx
     ppx_deriving.show
     ppx_deriving_yojson
     ppx_deriving.eq
     ppx_hash
     commons.ppx
   )
 )
)
