/*
  lens-javascript

  Extends the standard javascript grammar with lens pattern constructs.

  Lens metavariables are already valid javascript
  identifiers so we do nothing for them.

  Maintenance:

  - Most tests are not in the tree-sitter format, but are under
    /lang/javascript/test. To test the grammar, use:

      cd lang
      ./test-lang javascript

  - Some of the rules aren't really extended but were copy-pasted then edited.
    They may have to be updated more frequently. Tests should catch problems.
*/

const javascript_grammar = require('tree-sitter-javascript/grammar');

module.exports = grammar(javascript_grammar, {
  name: 'javascript',


  conflicts: ($, previous) => previous.concat([

    // conflicts between lens ellipsis and spread elements
    [$.spread_element, $.rest_pattern, $.lens_dots],
    [$.rest_pattern, $.lens_dots],
    [$.spread_element, $.lens_dots],

    // conflict occurring when extending '_formal_parameter'
    [$.primary_expression, $.formal_parameters],
  ]),

  rules: {

    /*
       We create multiple "entry points" so as to allow different kinds of
       lens patterns, prefixed with some new keyword.
    */

    // Original:
    //
    // program: $ => seq(
    //   optional($.hash_bang_line),
    //   repeat($.statement)
    // ),
    //
    program: $ => seq(
      optional($.hash_bang_line),
      choice (
        repeat($.statement),
        seq('__LENS_PARTIAL', $.lens_partial)
      )
    ),

    lens_dots: $ => '...',
    lens_ldots: $ => '<...',
    lens_rdots: $ => '...>',
    lens_metavar: $ => /\$[a-zA-Z_][a-zA-Z_0-9]*/,

    // Constructs valid as whole lens patterns only.
    //
    // pfff: sgrep_spatch_pattern
    lens_partial: $ => choice(
      // truncated 'function_declaration'
      seq(
        optional('async'),
        'function',
        $.identifier,
        $._call_signature
      ),
      // truncated 'class_declaration'
      seq(
        repeat($.decorator),
        'class',
        $.identifier,
        optional($.class_heritage),
      ),
      seq('if', $.parenthesized_expression),
      seq('try', $.statement_block),
      $.catch_clause,
      $.finally_clause
    ),

    // pfff: stmt
    statement: ($, previous) => {
      return choice(
        ...previous.members,
        // prec(100, $.lens_dots), // higher precedence than expression
        $.lens_for
      );
    },

    primary_expression: ($, previous) => {
      return choice(
        ...previous.members,

        // pfff: assignment_expr
        $.lens_dots, // conflict

        // pfff: primary_expr_no_braces
        $.lens_deep_expression,
      );
    },

    lens_deep_expression: $ => seq(
      $.lens_ldots, $.expression, $.lens_rdots
    ),

    // pfff: formal_parameter
    _formal_parameter: ($, previous) => {
      return choice(
        ...previous.members,
        $.lens_dots
      );
    },

    // pfff: class_element (repeated in the class body)
    class_body: $ => seq(
      '{',
      repeat(choice(
        seq(field('member', $.method_definition), optional(';')),
        seq(field('member', $.public_field_definition), $._semicolon),
        $.lens_dots, // added
      )),
      '}'
    ),

    // pfff: iteration_stmt
    lens_for: $ => seq(
      'for',
      '(',
      $.lens_dots,
      ')',
      $.statement // pfff: stmt1 (inline version of 'stmt')
    ),

    // pfff: xhp_attribute
    _jsx_attribute: ($, previous) => {
      return choice(
        ...previous.members,
        $.lens_dots,
      );
    },

    // pfff: xhp_attribute_value
    _jsx_attribute_value: ($, previous) => {
      return choice(
        ...previous.members,
        $.lens_dots,
        $.lens_metavar, // pfff: "$" XHPATTR  (in lexer_js.mll)
      );
    },

    // The original grammar was the following. Unfortunately, it's not really
    // extensible. TODO: It would be more maintainable if the repeated item had
    // its own rule in tree-sitter-javascript.
    //
    //     object: $ => prec('object', seq(
    //       '{',
    //       commaSep(optional(choice(
    //         $.pair,
    //         $.spread_element,
    //         $.method_definition,
    //         alias(
    //           choice($.identifier, $._reserved_identifier),
    //           $.shorthand_property_identifier
    //         )
    //       ))),
    //       '}'
    //     )),
    //
    // pfff: object_literal, property_name_and_value
    object: $ => prec('object', seq(
      '{',
      commaSep(optional(choice(
        $.pair,
        $.spread_element,
        $.method_definition,
        alias(
          choice($.identifier, $._reserved_identifier),
          $.shorthand_property_identifier
        ),
        $.lens_dots, // added
      ))),
      '}'
    )),

    // Original:
    //
    // member_expression: $ => prec('member', seq(
    //   field('object', choice($.expression, $.primary_expression)),
    //   choice('.', '?.'),
    //   field('property', alias($.identifier, $.property_identifier))
    // )),
    //
    // pfff: call_expr
    member_expression: $ => prec('member', seq(
      field('object', choice($.expression, $.primary_expression)),
      choice('.', '?.'),
      choice(
        field('property', alias($.identifier, $.property_identifier)),
        $.lens_dots // added
      )
    )),

    // Original:
    // _from_clause: $ => seq(
    //   "from", field('source', $.string)
    // ),
    //
    // pfff: module_specifier
    _from_clause: $ => seq(
      "from",
      choice(
        field('source', $.string),
        $.lens_metavar // added
      )
    ),
  }
});

// copy-pasted from the original grammar
function commaSep1(rule) {
  return seq(rule, repeat(seq(',', rule)));
}

// copy-pasted from the original grammar
function commaSep(rule) {
  return optional(commaSep1(rule));
}
