libs/ocaml-tree-sitter-lens/lang/*/parse
libs/ocaml-tree-sitter-lens/lang/*/grammar-rev.js.orig
libs/ocaml-tree-sitter-lens/lang/*/grammar-rev.js

# Repo to which we publish generated code.
libs/ocaml-tree-sitter-lens/lang/export

# From libs/ocaml-tree-sitter-lens/lang/lens-grammars/.gitignore
libs/ocaml-tree-sitter-lens/lang/lens-grammars/**/node_modules

# From libs/ocaml-tree-sitter-lens/lang/lens-grammars/src/.gitignore
libs/ocaml-tree-sitter-lens/lang/lens-grammars/src/tree-sitter-*
libs/ocaml-tree-sitter-lens/lang/lens-grammars/src/lens-*/**/binding.gyp
libs/ocaml-tree-sitter-lens/lang/lens-grammars/src/lens-*/**/index.js
libs/ocaml-tree-sitter-lens/lang/lens-grammars/src/lens-*/**/src
libs/ocaml-tree-sitter-lens/lang/lens-grammars/src/lens-*/**/inherited
libs/ocaml-tree-sitter-lens/lang/lens-grammars/src/lens-*/**/test.log

# tree-sitter generate (in 0.22+) emits these binding scaffolds next to
# the parser sources, even when --no-bindings is passed.
libs/ocaml-tree-sitter-lens/lang/lens-grammars/src/lens-*/**/.editorconfig
libs/ocaml-tree-sitter-lens/lang/lens-grammars/src/lens-*/**/.gitattributes
libs/ocaml-tree-sitter-lens/lang/lens-grammars/src/lens-*/**/.gitignore
libs/ocaml-tree-sitter-lens/lang/lens-grammars/src/lens-*/**/Package.swift
libs/ocaml-tree-sitter-lens/lang/lens-grammars/src/lens-*/**/pyproject.toml
libs/ocaml-tree-sitter-lens/lang/lens-grammars/src/lens-*/**/setup.py

# lens-powershell's prep script rewrites the upstream grammar from
# ESM to CJS into this file.
libs/ocaml-tree-sitter-lens/lang/lens-grammars/src/lens-powershell/grammar-base.js

# sed -i -e backups left on macOS by prep scripts (e.g. lens-c-sharp-pro).
libs/ocaml-tree-sitter-lens/lang/lens-grammars/src/**/**/*.js-e

# From src/spacegrep/.gitignore
src/spacegrep/**/_build
src/spacegrep/**/.merlin
src/spacegrep/tmp

# From tests/lens-rules/.gitignore
tests/lens-rules/**/__pycache__/
tests/lens-rules/**/.benchmarks/
tests/lens-rules/**/.pytest_cache/
tests/lens-rules/**/.DS_Store
tests/lens-rules/**/.vscode/
tests/lens-rules/**/.venv

