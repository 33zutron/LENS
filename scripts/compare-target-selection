#! /usr/bin/env bash
#
# A script used by Martin to compare file targeting results between
# pylens and olens.
#
set -eu

pylens="olens"
olens="olens --experimental"

echo "=== pylens ==="
time $pylens --x-ls . > target-selection.pylens
grep '^selected' target-selection.pylens \
| cut -c 5- \
| sort -u > targets.pylens

echo -n "number of selected targets: "
wc -l targets.pylens

echo "=== olens ==="
time $olens --x-ls . > target-selection.olens
grep '^selected' target-selection.olens \
| cut -c 5- \
| sort -u > targets.olens

echo -n "number of selected targets: "
wc -l targets.olens

echo -n "number of differences in the set of selected targets: "
diff -u targets.pylens targets.olens \
| grep -P '^[+-]' \
| wc -l
